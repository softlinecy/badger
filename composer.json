{
    "name": "softlinecy/badger",
    "version": "1.0.1",
    "description": "A badge generator for Laravel.",
    "keywords": ["badger", "badge", "shield", "svg", "Badger", "Cachet", "CachetHQ"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/cachethq/badger/issues",
        "source": "https://github.com/cachethq/badger"
    },
    "authors": [
        {
            "name": "James Brooks",
            "email": "james@alt-three.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^9.0|^10.0|v11.0",
        "illuminate/support": "^9.0|^10.0|v11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^v9.14.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^v3.0.0"
    },
    "autoload": {
        "psr-4": {
            "Cachet\\Badger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cachet\\Tests\\Badger\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cachet\\Badger\\BadgerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
